# Copy these into Vercel → Project → Settings → Environment Variables
# (or into a .env.local file if you run the app on your own computer)

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase → Project Settings → API Keys → Secret key (starts with sb_secret_)
# Server-only. Never put this in client code or commit it to GitHub.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Password for the /admin page (username can be anything)
ADMIN_PASSWORD=choose-a-strong-password
